layout {

    focus-ring {
        active-color   "#e7e5c6"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#e7e5c6"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#e7e5c6"
        inactive-color "#cbc9ab"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#e7e5c680"
    }
}

recent-windows {
    highlight {
        active-color "#e7e5c6"
        urgent-color "#ffb4ab"
    }
}
