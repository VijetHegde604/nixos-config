// DMS Window Rules - Managed by DankMaterialShell
// Do not edit manually - changes may be overwritten

// @id=wr_1772395503671978020 @name=org.gnome.Nautilus
window-rule {
    match app-id="^org.gnome.Nautilus$"
    open-floating true
    default-column-width { proportion 0.6; }
    default-window-height { proportion 0.6; }
}

// @id=wr_1774262336604143996 @name=chrome-music.youtube.com__-Default
window-rule {
    match app-id="^chrome-music.youtube.com__-Default$"
    open-floating true
    default-column-width { proportion 0.7; }
    default-window-height { proportion 0.7; }
}

// @id=wr_1783607318816256721 @name=com.danklinux.dms
window-rule {
    match app-id="^com.danklinux.dms$"
    open-floating true
}

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^com.danklinux.dms$"
    open-floating true
}
